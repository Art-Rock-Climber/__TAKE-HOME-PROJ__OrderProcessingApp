{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "[HH:mm:ss] ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { 
    "DefaultConnection": "Host=postgres-order;Database=orderdb;Username=postgres;Password=postgres"
  },
  "PaymentService": {
    "BaseUrl": "http://paymentservice:8080"
  }
}
